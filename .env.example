# Frontend API Configuration
NEXT_PUBLIC_API_URL=https://api.pintaara.com/api
NEXT_PUBLIC_ADMIN_URL=https://admin.pintaara.com

# Razorpay Client-Side Key ID (matches RAZORPAY_KEY_ID in backend/.env)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Local test customer (localhost only — created for checkout/UI testing,
# not a real person). Sign in at http://localhost:3000/login
# TEST_CUSTOMER_EMAIL=customer@example.com
# TEST_CUSTOMER_PASSWORD=your_secure_password
