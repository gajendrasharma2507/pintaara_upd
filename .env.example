# Frontend API Configuration
# Point this to your Laravel backend API hosted on Hostinger:
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Razorpay Client-Side Key ID (matches RAZORPAY_KEY_ID in backend/.env)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Local test customer (localhost only — created for checkout/UI testing,
# not a real person). Sign in at http://localhost:3000/login
# TEST_CUSTOMER_EMAIL=test.customer.pdf@example.com
# TEST_CUSTOMER_PASSWORD=Ptb0c065897a!9a
